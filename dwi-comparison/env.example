# Copy to .env (git-ignore it).

SNOWFLAKE_ACCOUNT=lh48692.ap-southeast-2.privatelink
SNOWFLAKE_USER=first.last@elmosoftware.com.au
SNOWFLAKE_WAREHOUSE=BI_WH
SNOWFLAKE_ROLE=

# SSO via browser (Okta/AAD). Token is cached locally so re-runs don't re-prompt.
SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Only needed if NOT using externalbrowser:
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# SNOWFLAKE_DATABASE / SNOWFLAKE_SCHEMA are not needed - every query is fully
# qualified from dwi.prod_db / dwi.uat_db in config.yaml.

# AWS for the S3 CSV mode. Any standard boto3 credential source works.
# Leave AWS_PROFILE commented out unless you use a named profile from
# ~/.aws/config (list them with: aws configure list-profiles).
# AWS_PROFILE=p-elmo
AWS_DEFAULT_REGION=ap-southeast-2
